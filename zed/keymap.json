// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    }
  },
  {
    "bindings": {
      "ctrl-l": "panel::NextPanelTab"
    }
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-h": "vim::GoToPreviousTab"
    }
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-l": "vim::GoToTab"
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "shift-l": "vim::EndOfLine"
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "shift-h": "vim::StartOfLineDownward"
    }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"]
    }
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "f i f": "search::FocusSearch"
    }
  }
]
